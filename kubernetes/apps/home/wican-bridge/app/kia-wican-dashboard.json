    },
    {
      "id": 9,
      "type": "xychart",
      "title": "SoC buffer \u2014 (display \u2212 BMS) vs display SoC",
      "description": "Traces the pack's reserved-buffer shape. Display SoC is the BMS value rescaled onto the usable window, so divergence is positive near full (top buffer, measured ~3.5 pts) and goes negative near empty (display reaches 0 while charge remains). Use this to set the bridge's MAX_BMS_ABOVE_DISPLAY bound from evidence once low-SoC data exists.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-wican"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "show": "points",
            "pointSize": {
              "fixed": 4
            },
            "axisLabel": ""
          },
          "unit": "percent"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "display_soc"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Display SoC (%)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "divergence"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "display \u2212 BMS (pts)"
              }
            ]
          }
        ]
      },
      "options": {
        "mapping": "manual",
        "series": [
          {
            "x": {
              "matcher": {
                "id": "byName",
                "options": "display_soc"
              }
            },
            "y": {
              "matcher": {
                "id": "byName",
                "options": "divergence"
              }
            }
          }
        ],
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-wican"
          },
          "query": "from(bucket: \"kia-wican\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wican\" and (r._field == \"SOC\" or r._field == \"SOC_BMS\"))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.SOC and exists r.SOC_BMS)\n  |> map(fn: (r) => ({_time: r._time, display_soc: r.SOC, divergence: r.SOC - r.SOC_BMS}))\n  |> keep(columns: [\"_time\", \"display_soc\", \"divergence\"])"
        }
      ]
