        }
      ],
      "description": "Min/max envelope per window, not mean: brief regen spikes average away on wide time ranges. Signed two's-complement from the BMS, verified on a drive at ~+37 A cruising and -148 A / -92.5 kW peak regen."
    },
    {
      "id": 9,
      "type": "trend",
      "title": "SoC buffer \u2014 (display \u2212 BMS) vs display SoC",
      "description": "Median divergence per 0.5% SoC step \u2014 the pack's reserved-buffer curve. Positive near full (display leads BMS); expected to cross zero and go negative near empty, where display reaches 0 while charge remains. Bucketed by SoC rather than time, and bounded to plausible divergence so historical corruption doesn't distort it.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-wican"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "display_soc"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.axisLabel",
                "value": "display SoC (%)"
              },
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": true,
                  "tooltip": true,
                  "viz": true
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "divergence"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "displayName",
                "value": "display \u2212 BMS"
              },
              {
                "id": "custom.axisLabel",
                "value": "display \u2212 BMS (points)"
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "display_soc",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-wican"
          },
          "query": "from(bucket: \"kia-wican\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wican\" and (r._field == \"SOC\" or r._field == \"SOC_BMS\"))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.SOC and exists r.SOC_BMS)\n  |> map(fn: (r) => ({display_soc: r.SOC, divergence: r.SOC - r.SOC_BMS}))\n  // same plausibility bound the bridge applies, so pre-filter corruption\n  // still in the bucket does not distort the curve\n  |> filter(fn: (r) => r.divergence <= 10.0 and r.divergence >= -30.0)\n  // bucket by SoC level, not by time: the curve IS divergence-per-SoC, and\n  // this collapses ~7k raw points to one per 0.5% step (Grafana truncates\n  // above ~688 points at this panel size)\n  |> group(columns: [\"display_soc\"])\n  |> median(column: \"divergence\")\n  |> group()\n  |> keep(columns: [\"display_soc\", \"divergence\"])\n  |> sort(columns: [\"display_soc\"])"
        }
      ]
    }
