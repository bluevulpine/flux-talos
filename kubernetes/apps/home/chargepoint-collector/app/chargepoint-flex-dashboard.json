          "query": "from(bucket: \"chargepoint\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"expected_state\" and r._field == \"schedule_name\")\n  |> last()"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Charging state",
      "description": "charger_status.charging_state. Note: CHARGING persists a while after power stops flowing — power_kw in session_sample is the truth for energy actually moving.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-chargepoint"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 14,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "$${__field.labels.charger}",
          "mappings": [
            {
              "type": "value",
              "options": {
                "CHARGING": {
                  "text": "Charging",
                  "color": "green"
                },
                "AVAILABLE": {
                  "text": "Idle",
                  "color": "text"
                },
                "": {
                  "text": "— depowered",
                  "color": "blue"
                },
                "CHARGING_STOPPED": {
                  "text": "Stopped",
                  "color": "text"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-chargepoint"
          },
          "query": "from(bucket: \"chargepoint\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"charger_status\" and r._field == \"charging_state\")\n  |> filter(fn: (r) => r.charger =~ /^$${charger:regex}$/)\n  |> group(columns: [\"charger\"])\n  |> last()"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Collector errors",
      "description": "collector_health.consecutive_errors — written only on error, so no data = healthy. Long low-grade streams can be a benign lingering-session detail failure, not an outage.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-chargepoint"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "$${__field.labels.account}",
          "unit": "none",
          "decimals": 0,
          "noValue": "healthy",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-chargepoint"
          },
          "query": "from(bucket: \"chargepoint\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"collector_health\" and r._field == \"consecutive_errors\")\n  |> group(columns: [\"account\"])\n  |> last()"
        }
      ]
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "Off-peak conformance — schedule vs actual charger state",
      "description": "Top lane: what the RLEC schedule expects. Charger lanes: actual is_connected. Lanes should match, and both chargers should flip together (shared load-control circuit). Blank stretches = collector gap (backoff), rendered distinctly from OFF on purpose.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-chargepoint"
      },
      "interval": "2m",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 75,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFF",
                  "color": "blue"
                },
                "1": {
                  "text": "ON",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "$${__field.labels.charger}"
              }
            ]
          }
        ]
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.85,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-chargepoint"
          },
          "query": "from(bucket: \"chargepoint\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"expected_state\" and r._field == \"expected_on\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: true)\n  |> set(key: \"_field\", value: \"schedule (expected)\")\n  |> drop(columns: [\"_start\", \"_stop\", \"_measurement\"])"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-chargepoint"
          },
          "query": "from(bucket: \"chargepoint\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"charger_status\" and r._field == \"is_connected\")\n  |> filter(fn: (r) => r.charger =~ /^$${charger:regex}$/)\n  |> group(columns: [\"charger\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: true)\n  |> drop(columns: [\"_start\", \"_stop\", \"_measurement\", \"_field\", \"account\"])"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Charging power",
      "description": "session_sample.power_kw — actual power flowing. Point time is the API sample timestamp; cadence is irregular (~1–4 min).",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-chargepoint"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": false
          },
          "displayName": "$${__field.labels.charger}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
