{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "title": "ChargePoint Home Flex — Charging & Off-Peak Conformance",
  "uid": "chargepoint-home-flex",
  "tags": [
    "chargepoint",
    "ev",
    "rlec"
  ],
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "charger",
        "label": "Charger",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-chargepoint"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"chargepoint\", tag: \"charger\")",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Charger power state",
      "description": "is_connected per charger. OFF during RLEC off-peak windows is normal, not an outage. Both chargers share one load-control circuit — they should match.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-chargepoint"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "$${__field.labels.charger}",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFF",
                  "color": "blue"
                },
                "1": {
                  "text": "ON",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-chargepoint"
          },
          "query": "from(bucket: \"chargepoint\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"charger_status\" and r._field == \"is_connected\")\n  |> filter(fn: (r) => r.charger =~ /^$${charger:regex}$/)\n  |> group(columns: [\"charger\"])\n  |> last()"
        }
      ]
    },
    {
