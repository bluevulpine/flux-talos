          },
          "query": "from(bucket: \"chargepoint\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"session_sample\" and r._field == \"energy_kwh\")\n  |> filter(fn: (r) => r.charger =~ /^$${charger:regex}$/)\n  |> group(columns: [\"charger\", \"session_id\"])\n  |> difference(nonNegative: true)\n  |> group()\n  |> sum()"
        }
