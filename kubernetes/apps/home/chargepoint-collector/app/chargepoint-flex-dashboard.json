    {
      "id": 12,
      "type": "table",
      "title": "Session summaries (last per session_id)",
      "description": "One row per session_id — the latest finalize wins; values are cumulative across off-peak power cycles, never sum() these. synthesized=1 marks lower-confidence snapshot-fallback summaries.",
