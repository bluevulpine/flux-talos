            "uid": "influxdb-chargepoint"
          },
          "query": "from(bucket: \"chargepoint\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"session_summary\")\n  |> filter(fn: (r) => r.charger =~ /^$${charger:regex}$/)\n  |> group(columns: [\"charger\", \"session_id\", \"_field\"])\n  |> last()\n  |> toFloat()\n  |> group(columns: [\"charger\", \"session_id\"])\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> keep(columns: [\"_time\", \"charger\", \"session_id\", \"energy_kwh\", \"duration_s\", \"miles_added\", \"synthesized\"])"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Collector errors (per account)",
      "description": "collector_health.consecutive_errors — points exist only on error, so an empty panel is the healthy state. Counts include session-detail-only failures that can run for hours benignly (lingering fully_charged session with a 500ing detail endpoint) while charger_status keeps flowing.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-chargepoint"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "points",
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": false
          },
          "displayName": "$${__field.labels.account}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-chargepoint"
          },
          "query": "from(bucket: \"chargepoint\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"collector_health\" and r._field == \"consecutive_errors\")\n  |> group(columns: [\"account\"])\n  |> drop(columns: [\"_start\", \"_stop\", \"_measurement\", \"_field\", \"charger\"])"
        }
      ]
    },
    {
      "id": 14,
      "type": "state-timeline",
      "title": "Plugged in",
      "description": "charger_status.is_plugged_in. While a charger is depowered (off-peak) it reports 0 even with the car plugged — an offline artifact, same as amperage_limit=0.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-chargepoint"
      },
      "interval": "2m",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 75,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "unplugged / depowered",
                  "color": "text"
                },
                "1": {
                  "text": "plugged in",
                  "color": "blue"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          },
          "displayName": "$${__field.labels.charger}"
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.85,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-chargepoint"
          },
          "query": "from(bucket: \"chargepoint\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"charger_status\" and r._field == \"is_plugged_in\")\n  |> filter(fn: (r) => r.charger =~ /^$${charger:regex}$/)\n  |> group(columns: [\"charger\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: true)\n  |> drop(columns: [\"_start\", \"_stop\", \"_measurement\", \"_field\", \"account\"])"
        }
      ]
    }
  ]
