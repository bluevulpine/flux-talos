      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-chargepoint"
          },
          "query": "from(bucket: \"chargepoint\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"session_sample\" and r._field == \"power_kw\")\n  |> filter(fn: (r) => r.charger =~ /^$${charger:regex}$/)\n  |> group(columns: [\"charger\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\n  |> drop(columns: [\"_start\", \"_stop\"])"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Session energy (cumulative per session_id)",
      "description": "session_sample.energy_kwh is cumulative within a session (staircase; plateaus while idle). ChargePoint reuses session ids across off-peak power cycles, so multi-day 300+ kWh staircases are real, correct data.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-chargepoint"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "displayName": "$${__field.labels.charger} session $${__field.labels.session_id}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-chargepoint"
          },
          "query": "from(bucket: \"chargepoint\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"session_sample\" and r._field == \"energy_kwh\")\n  |> filter(fn: (r) => r.charger =~ /^$${charger:regex}$/)\n  |> group(columns: [\"charger\", \"session_id\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> drop(columns: [\"_start\", \"_stop\"])"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Energy per day",
      "description": "Derived from session_sample via difference() on cumulative energy_kwh (never from summaries — see CLAUDE.md query rules). Days are America/Chicago to match RLEC billing.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-chargepoint"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-chargepoint"
          },
          "query": "import \"timezone\"\noption location = timezone.location(name: \"America/Chicago\")\n\nfrom(bucket: \"chargepoint\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"session_sample\" and r._field == \"energy_kwh\")\n  |> filter(fn: (r) => r.charger =~ /^$${charger:regex}$/)\n  |> group(columns: [\"charger\", \"session_id\"])\n  |> difference(nonNegative: true)\n  |> group(columns: [\"charger\"])\n  |> aggregateWindow(every: 1d, fn: sum, createEmpty: false, timeSrc: \"_start\")\n  |> drop(columns: [\"_start\", \"_stop\"])"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Energy delivered (range)",
      "description": "Sum of session_sample energy deltas over the dashboard range.",
      "datasource": {
        "type": "influxdb",
