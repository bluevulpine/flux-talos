    {
      "type": "timeseries",
      "title": "Heating hours per heating degree day (monthly)",
      "id": 42,
      "description": "Total heating runtime divided by the weather's heating demand, per month. Because it is normalised by degree days, a rising line means the system is working harder for the same weather \u2014 the signature of degrading equipment, a failing envelope, or a changed setpoint. Months with under 20 HDD are excluded as too noisy to divide by.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-beestat"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-beestat"
          },
          "query": "base = from(bucket: \"beestat\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"runtime_thermostat_summary\")\n  |> filter(fn: (r) => r._field == \"sum_compressor_heat_1\"\n        or r._field == \"sum_auxiliary_heat_1\" or r._field == \"sum_heating_degree_days\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\nrt = base\n  |> map(fn: (r) => ({_time: r._time,\n        _value: (r.sum_compressor_heat_1 + r.sum_auxiliary_heat_1) / 3600.0}))\n  |> aggregateWindow(every: 1mo, fn: sum, createEmpty: false)\nhd = base\n  |> map(fn: (r) => ({_time: r._time, _value: r.sum_heating_degree_days}))\n  |> aggregateWindow(every: 1mo, fn: sum, createEmpty: false)\njoin(tables: {a: rt, b: hd}, on: [\"_time\"])\n  |> filter(fn: (r) => r._value_b > 20.0)\n  |> map(fn: (r) => ({_time: r._time, _value: r._value_a / r._value_b}))\n  |> group() |> rename(columns: {_value: \"Heating hours per HDD\"})",
