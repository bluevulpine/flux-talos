      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-beestat"
          },
          "query": "from(bucket: \"beestat\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"runtime_thermostat_summary\")\n  |> filter(fn: (r) => r._field == \"sum_compressor_cool_1\")\n  |> map(fn: (r) => ({_time: r._time, _value: r._value / 3600.0}))\n  |> group() |> rename(columns: {_value: \"Cool\"})",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-beestat"
          },
          "query": "from(bucket: \"beestat\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"runtime_thermostat_summary\")\n  |> filter(fn: (r) => r._field == \"sum_compressor_heat_1\")\n  |> map(fn: (r) => ({_time: r._time, _value: r._value / 3600.0}))\n  |> group() |> rename(columns: {_value: \"Heat pump\"})",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-beestat"
          },
          "query": "from(bucket: \"beestat\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"runtime_thermostat_summary\")\n  |> filter(fn: (r) => r._field == \"sum_auxiliary_heat_1\")\n  |> map(fn: (r) => ({_time: r._time, _value: r._value / 3600.0}))\n  |> group() |> rename(columns: {_value: \"Aux (propane)\"})",
