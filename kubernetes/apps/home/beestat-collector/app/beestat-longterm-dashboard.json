      "type": "timeseries",
      "title": "Runtime by day, with outdoor temperature",
      "id": 36,
      "description": "Equivalent of beestat's Analyze view. Stacked daily equipment hours against average outdoor temperature on the right axis. The shape shows the seasonal envelope and, in winter, how much of the heating load falls to propane rather than the heat pump.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-beestat"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
