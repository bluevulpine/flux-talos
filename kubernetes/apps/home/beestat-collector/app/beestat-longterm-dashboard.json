    {
      "type": "barchart",
      "title": "Balance point \u2014 average heating hours per day by outdoor temperature",
      "id": 38,
      "description": "For each 5 degF band of average outdoor temperature, the mean hours per day the heat pump ran versus the propane furnace, across all history. Where the red bars overtake the orange is this system's real-world balance point. Propane appearing at mild temperatures suggests the aux lockout is set higher than it needs to be \u2014 that is burnable money.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-beestat"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-beestat"
          },
          "query": "from(bucket: \"beestat\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"runtime_thermostat_summary\")\n  |> filter(fn: (r) => r._field == \"sum_auxiliary_heat_1\"\n        or r._field == \"sum_compressor_heat_1\" or r._field == \"avg_outdoor_temperature\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.avg_outdoor_temperature)\n  |> map(fn: (r) => ({\n        bucket: float(v: int(v: (r.avg_outdoor_temperature + 100.0) / 5.0))\n                * 5.0 - 100.0,\n        aux: r.sum_auxiliary_heat_1 / 3600.0,\n        hp: r.sum_compressor_heat_1 / 3600.0}))\n  |> group(columns: [\"bucket\"])\n  |> reduce(identity: {aux: 0.0, hp: 0.0, n: 0.0},\n      fn: (r, accumulator) => ({aux: accumulator.aux + r.aux,\n        hp: accumulator.hp + r.hp, n: accumulator.n + 1.0}))\n  |> map(fn: (r) => ({outdoor_f: r.bucket,\n        heatpump_h: r.hp / r.n, propane_h: r.aux / r.n, days: r.n}))\n  |> group()\n  |> filter(fn: (r) => r.days >= 3.0)\n  |> sort(columns: [\"outdoor_f\"])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:h",
          "decimals": 2,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "none",
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "outdoor_f"
            },
            "properties": [
              {
                "id": "unit",
                "value": "fahrenheit"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "heatpump_h"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "displayName",
                "value": "Heat pump (h/day)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "propane_h"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "displayName",
                "value": "Propane aux (h/day)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "days"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": true,
                  "tooltip": false,
                  "viz": true
                }
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "outdoor_f",
