    {
      "type": "barchart",
      "title": "Cooling load \u2014 average and busiest-day hours by outdoor temperature",
      "id": 39,
      "description": "The cooling counterpart to the balance point above. Orange is the mean hours per day in each 5 degF band; the paler bar is the busiest single day in that band, so the gap between them is the headroom before the system would run flat out. The line is mean indoor temperature: it holding flat across the hot buckets is the evidence the system keeps up. Buckets with fewer than 3 days are dropped, since a one-day 'average' is not one.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-beestat"
      },
      "gridPos": {
        "h": 11,
        "w": 16,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-beestat"
          },
