    {
      "id": 7,
      "type": "timeseries",
      "title": "Where the energy went",
      "description": "Drivetrain + climate + accessories + battery management sum exactly to the trip total; regeneration sits outside that sum and has its own panel. Merged trips carry no energy breakdown at all \u2014 Kia drops the key rather than zeroing it \u2014 so they are excluded here but still counted in distance.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-kiatrips"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-kiatrips"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT local_date AS time,\n       sum(ev_drivetrain_wh)/1000.0    AS \"Drivetrain\",\n       sum(ev_climate_wh)/1000.0       AS \"Climate\",\n       sum(ev_accessories_wh)/1000.0   AS \"Accessories\",\n       sum(ev_battery_mgmt_wh)/1000.0  AS \"Battery mgmt\"\nFROM trips\nWHERE superseded_at IS NULL AND ev_total_power_wh IS NOT NULL AND $$__timeFilter(start_dt)\nGROUP BY local_date ORDER BY local_date",
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 2,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 85,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barAlignment": 0,
            "axisSoftMin": 0,
            "gradientMode": "none",
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Drivetrain"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Climate"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
