{
  "uid": "ha-explorer",
  "title": "Home Assistant — Explorer",
  "tags": [
    "home-assistant",
    "explorer"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "domain",
        "label": "Domain",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-ha"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"homeassistant\", tag: \"domain\")",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "sensor",
          "value": "sensor"
        },
        "sort": 1
      },
      {
        "name": "entity",
        "label": "Entity",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-ha"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"homeassistant\", tag: \"entity_id\", predicate: (r) => r.domain == \"$${domain}\", start: -30d)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Value over time — $$domain",
      "gridPos": {
        "h": 12,
        "w": 18,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-ha"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-ha"
          },
          "query": "from(bucket: \"homeassistant\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.domain == \"$${domain}\" and r.entity_id =~ /^$${entity:regex}$/ and r._field == \"value\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> group(columns: [\"entity_id\", \"friendly_name\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "last",
            "min",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1
    },
    {
      "type": "table",
      "title": "Current values",
      "gridPos": {
        "h": 12,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-ha"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-ha"
          },
          "query": "from(bucket: \"homeassistant\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.domain == \"$${domain}\" and r.entity_id =~ /^$${entity:regex}$/ and r._field == \"value\")\n  |> last()\n  |> group()\n  |> keep(columns: [\"friendly_name\", \"_measurement\", \"_value\"])\n  |> rename(columns: {_measurement: \"unit\", _value: \"value\", friendly_name: \"entity\"})\n  |> sort(columns: [\"entity\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "entity",
            "desc": false
          }
        ]
      },
      "id": 2
    }
  ]
}
