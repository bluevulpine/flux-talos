    {
      "type": "timeseries",
      "title": "Mean inter-token latency",
      "description": "Average time between generated tokens. Rises with concurrency, and with Tdarr NVENC transcoding (shared memory bandwidth, ~30% measured).",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(vllm:inter_token_latency_seconds_sum{job=\"vllm-spark\"}[$__rate_interval])) / sum(rate(vllm:inter_token_latency_seconds_count{job=\"vllm-spark\"}[$__rate_interval]))",
          "legendFormat": "mean ITL",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "barAlignment": 0,
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "axisSoftMin": 0
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
