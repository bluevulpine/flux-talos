    {
      "type": "row",
      "title": "vLLM health (live)",
      "id": 8,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests running / waiting",
      "description": "Requests in vLLM's batch vs queued. Waiting > 0 means the KV cache or scheduler is the limit.",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(vllm:num_requests_running{job=\"vllm-spark\"})",
          "legendFormat": "running",
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(vllm:num_requests_waiting{job=\"vllm-spark\"})",
          "legendFormat": "waiting",
          "range": true,
          "instant": false,
