    {
      "type": "timeseries",
      "title": "Tokens per hour",
      "description": "vLLM token volume per hour. Generated includes gpt-oss's hidden reasoning (billed as output by APIs). Cached prompt = prefix-cache hits, priced at cache-read rates in the cost series.",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "last_over_time(spark:vllm_prompt_tokens:increase1h[1h]) - last_over_time(spark:vllm_cached_prompt_tokens:increase1h[1h])",
          "legendFormat": "prompt (uncached)",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "1h"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "last_over_time(spark:vllm_cached_prompt_tokens:increase1h[1h])",
          "legendFormat": "prompt (cached)",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "1h"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "last_over_time(spark:vllm_generation_tokens:increase1h[1h])",
          "legendFormat": "generated",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 80,
            "barAlignment": 0,
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisPlacement": "auto",
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "prompt (uncached)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "prompt (cached)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "generated"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1h"
