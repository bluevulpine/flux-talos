# Bootstrap
/config.yaml

# Bitwarden Secrets Manager (local dev only)
.bws_access_token

# Talos client config (admin cert + key): written by `topf talosconfig`, never tracked
**/talosconfig*
talos/*.iso

# topf render writes PLAINTEXT machine configs (PKI included) to ./output by default.
# Bare and un-anchored on purpose so it matches at any depth; `talos/output/` would
# not match a render run from the repo root.
output/
talos/*.decrypted*
# topf's default secretsPath, and where a bare `--confirm=false` with a wrong path WRITES A NEW
# PLAINTEXT PKI (measured in Phase 0). Nothing tracked is named this.
talos/secrets.yaml

# Claude Code scratch (session ledgers, briefs, worktrees) — never commit
.superpowers/
.claude/worktrees/

# Codex (ChatGPT desktop app) auto-generates this by porting CLAUDE.md on first
# open. We don't use Codex deliberately; keep the local copy out of git.
AGENTS.md

# Python bytecode (scripts/twit-transcripts is imported by hand when testing)
__pycache__/

# Rendered Talos machine configs hold the full PKI in plaintext (talhelper's old
# output dir; commit 60dc0f1fb leaked one). topf renders only to a mktemp dir,
# but stale checkouts still carry this directory.
talos/clusterconfig/
