#!/bin/bash
# fake gh: pr view N -> $FX/pr-N.json ; pr list --head <app>-move-pr1 --state merged -> $FX/merged-pr1.txt (else 0) ; writes are logged
FX=${FX:?}; echo "gh $*" >> "$FX/calls.log"
case "$1 $2" in
  "pr view") cat "$FX/pr-$3.json" || exit 1;;
  "pr list") case "$*" in *-move-pr1*) cat "$FX/merged-pr1.txt";; *) echo 0;; esac;;
  "pr ready"|"pr merge") exit 0;;
  *) exit 0;;
esac
