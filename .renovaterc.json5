{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "github>bluevulpine/flux-talos//.renovate/autoMerge.json5",
    "github>bluevulpine/flux-talos//.renovate/changelogs.json5",
    "github>bluevulpine/flux-talos//.renovate/customManagers.json5",
    "github>bluevulpine/flux-talos//.renovate/grafanaDashboards.json5",
    "github>bluevulpine/flux-talos//.renovate/groups.json5",
    "github>bluevulpine/flux-talos//.renovate/labels.json5",
    "github>bluevulpine/flux-talos//.renovate/overrides.json5",
    "github>bluevulpine/flux-talos//.renovate/semanticCommits.json5",
    "github>bluevulpine/flux-talos//.renovate/valheimMods.json5",
    ":automergeBranch",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(America/Chicago)",
  ],
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  // List packages with no release in 6 months in the dashboard's "abandoned" section. It only
  // works where the datasource gives release dates (Docker Hub yes, most ghcr.io no), and it
  // cannot see a project that moved while still tagging the old name (Jellyseerr, 2026-10).
  // scripts/upstream-moved.py (weekly, issue labelled upstream-moved) covers that case.
  abandonmentThreshold: "6 months",
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  ignorePaths: [
    "**/*.sops.*",
    "**/resources/**",
  ],
  flux: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
}
