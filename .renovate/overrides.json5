{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Override Helmfile Dependency Name",
      matchDatasources: ["docker"],
      matchManagers: ["helmfile"],
      overrideDepName: "{{packageName}}",
    },
    {
      description: "Override Talos Installer Package Name",
      matchDatasources: ["docker"],
      matchPackageNames: ["/factory\\.talos\\.dev/"],
      overridePackageName: "ghcr.io/siderolabs/installer",
    },
    {
      // The cluster is on Talos 1.13. Renovate proposed talosctl 1.14.1 (a minor AHEAD of every
      // node) in #1849 and siderolabs/talos 1.14.1 in #1733; 1.14 changes generated defaults
      // (workloadIsolation on, an auto-generated KubeFlannelCNIConfig that would start Flannel
      // beside Cilium) that topf would apply on the next `apply`. So the whole Talos family is
      // held to 1.13.x, and the client stays on the same minor as the nodes.
      // TO MOVE TO 1.14: delete this rule (or change the regex to 1\.14), and read the 1.14
      // notes in docs/superpowers/specs/2026-08-31-talhelper-to-topf-design.md first.
      description: "Talos: hold installer, talosctl and the release version at 1.13.x",
      matchDatasources: ["docker", "github-releases"],
      // Exact names, not the /installer/ substring the group uses: this rule CAPS versions, and
      // an unrelated future image with "installer" in its name must not be silently held back.
      matchPackageNames: ["ghcr.io/siderolabs/installer", "ghcr.io/siderolabs/talosctl", "siderolabs/talos"],
      allowedVersions: "/^v?1\\.13\\./",
    },
    {
      // Talos 1.13 runs Kubernetes up to 1.36.x only: kubernetesVersion v1.37.0 was rejected by
      // the config generator ("version of Kubernetes 1.37.0 is too new to be used with Talos
      // 1.13.9") and reverted in cadc45e3. Renovate's github-releases/docker datasources know
      // nothing about the Talos support matrix, so without this cap it keeps proposing 1.37
      // (#1678 sat open for weeks) -- and the tuppr KubernetesUpgrade is NOT suspended, so a
      // merged kubelet bump would start an unsupported upgrade on its own.
      // These two names are the only places the cluster's Kubernetes version is set:
      // kubernetesVersion in talos/topf.yaml and the KubernetesUpgrade CR.
      // TO MOVE TO 1.37: only after the nodes are on Talos 1.14 (see the Talos rule above);
      // then change the regex to 1\.37 together with the Talos one.
      description: "Kubernetes: hold at 1.36.x while Talos is held at 1.13.x",
      matchDatasources: ["docker", "github-releases"],
      matchPackageNames: ["kubernetes/kubernetes", "ghcr.io/siderolabs/kubelet"],
      allowedVersions: "/^v?1\\.36\\./",
    },
    {
      description: "Calibre-Web: Only allow 0.x versions (5.x is a different versioning scheme)",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/linuxserver/calibre-web"],
      allowedVersions: "/^0\\./",
    },
    {
      description: "Ignore tailscale-node-remover (uses unversioned 'main' tag)",
      matchDatasources: ["docker"],
      matchPackageNames: ["simonhaas/tailscale-node-remover"],
      enabled: false,
    },
    {
      // 1.17.0 regressed the ping/hole-punch path: every ICMP ping attempt
      // fails ("failed to read ICMP packet: i/o timeout"), tearing down the
      // tunnel and its in-flight proxy targets every ~3 minutes and causing
      // 502s from Traefik on the Pangolin VPS. Matches an open upstream
      // regression touching the ping function in fosrl/newt#449. Remove this
      // pin once upstream confirms a fix and it's been verified in staging.
      description: "Pin fosrl/newt below 1.17.0 (ping/hole-punch regression)",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/fosrl/newt"],
      allowedVersions: "<1.17.0",
    },
    {
      // gitea's HelmRelease has a top-level `image.repository`/`image.tag`
      // block, which Renovate's built-in *flux* manager extracts natively
      // (it parses `values:` inside Flux HelmRelease CRs the same way
      // helm-values parses a chart's values.yaml). The tag line ALSO carries
      // a `# renovate:` annotation matched by our customManager. Both match
      // the same line, so Renovate opens two PRs for one bump (flux ->
      // docker.io/gitea/gitea, customManager -> gitea/gitea). The annotation
      // is the repo convention, so suppress only the flux-native copy.
      //
      // Third time fixing this exact duplicate (#1389, #1540, now #1681):
      // the first two fixes only ever tuned matchPackageNames and never
      // questioned matchManagers. "helm-values" is a REAL but WRONG manager
      // slug here — per Renovate's own docs, `helm-values` only matches
      // files literally named values.yaml/values.yml, so it can never match
      // a HelmRelease file like helmrelease.yaml. The manager that actually
      // extracts image.repository/image.tag from a Flux HelmRelease's
      // values block is `flux`. Because the manager filter never matched,
      // `enabled: false` never applied, and the duplicate kept slipping
      // through no matter how the packageName regex was tuned. Confirmed
      // against https://docs.renovatebot.com/modules/manager/flux/ and
      // https://docs.renovatebot.com/modules/manager/helm-values/.
      //
      // Match by regex, NOT the exact string "docker.io/gitea/gitea": Renovate
      // normalizes the Docker Hub packageName to the un-prefixed "gitea/gitea",
      // so the old exact match never fired either. The `/gitea\/gitea$/` regex
      // matches with or without the docker.io/ registry prefix. Scoped to
      // matchManagers:["flux"] so it can never disable the annotation-based
      // customManager PR we want to keep (that one reports as a "regex"
      // manager, never "flux").
      description: "Gitea: drop the flux-native duplicate; image tracked via the # renovate annotation",
      matchManagers: ["flux"],
      matchPackageNames: ["/gitea\\/gitea$/"],
      enabled: false,
    },
  ],
}
